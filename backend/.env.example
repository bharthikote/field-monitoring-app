# Copy to .env for local development. On Render these are set in the
# service's Environment tab instead (see ../render.yaml) - never commit .env.

# Supabase: Project Settings -> Database -> Connection string (URI tab)
DATABASE_URL=

# Supabase: Project Settings -> API (Project URL, and the service_role key -
# server-side only, never put it in the mobile app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs login tokens. Use a long random value, different from local dev in
# production - changing it logs everyone out.
JWT_SECRET=

# Local only - Render sets PORT itself.
PORT=4000

# Optional: comma-separated browser origins allowed to call the API
# cross-origin. Leave unset: the web admin is same-origin and the phone app
# isn't a browser.
# ALLOWED_ORIGINS=
