# Expo SDK 57's new default fetch (the WinterCG-spec implementation) doesn't
# support React Native's classic FormData file shape ({ uri, name, type }) -
# every screen that uploads a photo (Log Visit, Farmer registration,
# Trainings, Field Days, Institution/Agro Dealer visits, Data Collection
# forms) uses that exact shape via multipart/form-data. This flag reverts
# fetch to React Native's original implementation, which still handles it
# correctly. See node_modules/expo/src/winter/runtime.native.ts.
EXPO_PUBLIC_USE_RN_FETCH=1

# The hosted backend (Render). Public address, not a secret. Remove this line
# to fall back to the laptop LAN address in src/config.js for local testing.
EXPO_PUBLIC_API_URL=https://field-monitoring.onrender.com
