# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local
# Exception: mobile/.env holds only EXPO_PUBLIC_* runtime flags (bundled
# into the client, never secret) - e.g. EXPO_PUBLIC_USE_RN_FETCH, required
# on every machine to avoid Expo SDK 57's fetch/FormData bug. backend/.env
# (the real secret, DATABASE_URL) stays ignored by the blanket rule above.
!mobile/.env

# Backend
backend/dist/
backend/build/

# Expo / React Native
mobile/.expo/
mobile/dist/
mobile/npm-debug.*
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/*.orig.*
mobile/web-build/
mobile/android/
mobile/ios/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
